[Unit]
Description=Create and verify Battlevive weekly PostgreSQL backup
After=docker.service battlevive-secrets.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/battlevive/backup weekly
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
