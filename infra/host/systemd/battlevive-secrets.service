[Unit]
Description=Render Battlevive runtime secrets from AWS Parameter Store
Wants=network-online.target
After=network-online.target amazon-ssm-agent.service
Before=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/battlevive/render-secrets
RemainAfterExit=yes
User=root
Group=root
UMask=0077
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
