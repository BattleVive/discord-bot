# Include only files consumed by Dockerfile.
**
!Dockerfile
!apk-build-deps.txt
!apk-runtime-deps.txt
!app/
!app/requirements.lock
!app/assets/
!app/assets/**
!app/main.py
!app/battlevive_bot/
!app/battlevive_bot/**

# Never traverse runtime mounts or include generated Python files.
app/data/
app/logs/
**/__pycache__/
*.py[cod]
